# Copy this file to .env for local runs. Never commit the real .env —
# it's already in .gitignore. In GitHub Actions these are read from
# repository secrets instead (Settings > Secrets and variables > Actions).

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional overrides — see src/config.py for defaults.
